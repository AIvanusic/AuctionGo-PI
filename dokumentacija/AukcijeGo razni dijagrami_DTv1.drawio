        <mxCell id="3ocHiVj6Nr2f3vBLKsSG-60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;aukcijski postupak (1predmet)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;aukcija_&lt;/span&gt;ID&lt;/div&gt;&lt;div&gt;artefakt ID&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;početna cijena&lt;/div&gt;&lt;div&gt;početak&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;aukcije yyyymmddhhmmss&lt;/span&gt;&lt;/div&gt;&lt;div&gt;trajanje aukcije do yyyymmddhhmmss&lt;/div&gt;&lt;div&gt;status aukcije(&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;aktivna&lt;/span&gt;, 1,2,zadnji poziv)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;tip aukcije (izdvojiti u tablicu???)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;aukcija_grupa ID&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;trenutno ponuđena ciejna -&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;ponuda ID, ponuđena cijena&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 153);&quot;&gt;korisnik ID&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;aukcija uspješno završena/poništena/bez ponuda&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;konačno postignuta cijena&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;spa